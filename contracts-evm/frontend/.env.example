# Copy to `frontend/.env` and fill in the deployed contract addresses.
# These are Vite env vars (must be prefixed with VITE_ to be exposed to the client).

# Target chain id (Sepolia = 11155111, Localhost/Hardhat = 31337)
VITE_CHAIN_ID=11155111

# Deployed contract addresses
VITE_PAYMENT_PROCESSOR_ADDRESS=
VITE_INVOICE_ADDRESS=
VITE_SUBSCRIPTION_ADDRESS=
