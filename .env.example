# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Deployer private key (no 0x prefix) — used for Sepolia deployment
PRIVATE_KEY=

# RPC URL for the Sepolia testnet (e.g. from Alchemy or Infura)
SEPOLIA_RPC_URL=

# Optional: Alchemy API key (alternative to SEPOLIA_RPC_URL)
ALCHEMY_API_KEY=

# Etherscan API key for contract verification on Sepolia
ETHERSCAN_API_KEY=

# PaymentProcessor / Invoice / Subscription constructor arguments
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
FEE_BPS=250
REFUND_WINDOW=604800
